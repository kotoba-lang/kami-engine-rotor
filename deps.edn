{:paths ["src"]
 ;; Reduced-order rotor solver on the shared, purpose-split libs.
 ;; Registers :rom-rotor on the cae-solver contract; turns a multirotor's
 ;; per-rotor thrust requirement into a sized rotor (diameter, RPM, shaft
 ;; power, torque) that motor.solver/size-for-power can then size a motor for.
 ;; A blade-resolved kami-cfd solve registers a higher-fidelity kind on the
 ;; same contract later.
 :deps {io.github.kotoba-lang/datom                  {:git/sha "3a45462b3b6da018e24c65d12f8f3d3250a0c38e"}
        io.github.kotoba-lang/kami-engine-cae-solver {:git/sha "214a1907890b75cbb5ed6781cf3dea8cba0f4351"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :dev {:override-deps {io.github.kotoba-lang/datom                  {:local/root "../datom"}
                        io.github.kotoba-lang/kami-engine-cae-solver {:local/root "../kami-engine-cae-solver"}}}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
